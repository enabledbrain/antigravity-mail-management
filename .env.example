# ==============================================================================
# Environment Configuration for AI Mailer
# ==============================================================================

# Specify the absolute path to your Thunderbird profile directory.
#
# Examples for macOS:
# THUNDERBIRD_PROFILE_PATH=/Users/username/Library/Thunderbird/Profiles/xxxxxxxx.default-release
#
# Examples for Windows:
# THUNDERBIRD_PROFILE_PATH=C:/Users/username/AppData/Roaming/Thunderbird/Profiles/xxxxxxxx.default-release
#
# Examples for custom cloud-synced folders (Dropbox / Google Drive):
# THUNDERBIRD_PROFILE_PATH=/path/to/Thunderbird/Profiles/xxxxxxxx.default

THUNDERBIRD_PROFILE_PATH=/path/to/Thunderbird/Profiles/xxxxxxxx.default
