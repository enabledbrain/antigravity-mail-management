@echo off
setlocal enabledelayedexpansion
cd /d "%~dp0"

echo ==========================================================
echo  antigravity-mail-management 初期セットアップウィザード
echo ==========================================================
echo.

:: 1. Thunderbird プロファイルの自動探索
echo [1/4] Thunderbird プロファイルを探索中...
set "PROFILE_CANDIDATE="

if exist "%APPDATA%\Thunderbird\Profiles" (
    for /d %%D in ("%APPDATA%\Thunderbird\Profiles\*.*") do (
        set "PROFILE_CANDIDATE=%%D"
    )
)

if not defined PROFILE_CANDIDATE (
    if exist "%USERPROFILE%\Dropbox\appData\Thunderbird\Profiles" (
        for /d %%D in ("%USERPROFILE%\Dropbox\appData\Thunderbird\Profiles\*.*") do (
            set "PROFILE_CANDIDATE=%%D"
        )
    )
)

if defined PROFILE_CANDIDATE (
    echo [OK] プロファイル候補を検出しました: !PROFILE_CANDIDATE!
    set /p "USE_DETECTED=このプロファイルを使用しますか？ [Y/n]: "
    if "!USE_DETECTED!"=="" set "USE_DETECTED=Y"
    if /i "!USE_DETECTED!"=="Y" (
        set "SELECTED_PROFILE=!PROFILE_CANDIDATE!"
    )
)

if not defined SELECTED_PROFILE (
    set /p "SELECTED_PROFILE=Thunderbird のプロファイル絶対パスを入力してください: "
)

:: 2. .env ファイルの作成
echo.
echo [2/4] .env ファイルを作成中...
(
    echo # Auto-generated by setup.bat
    echo THUNDERBIRD_PROFILE_PATH=!SELECTED_PROFILE!
) > .env
echo [OK] .env を作成しました。

:: 3. config.json の作成
echo.
echo [3/4] config.json を設定中...
if not exist config.json (
    copy config.example.json config.json >nul
    echo [INFO] config.json を作成しました。
)

:: 4. 初回キャッチアップ
echo.
echo [4/4] 初回キャッチアップ（過去メールの一括インデックス化）を実行しますか？
set /p "RUN_CATCHUP=実行しますか？ [Y/n]: "
if "!RUN_CATCHUP!"=="" set "RUN_CATCHUP=Y"

if /i "!RUN_CATCHUP!"=="Y" (
    echo [INFO] キャッチアップを実行中...
    call run.bat --init-catchup
)

echo.
echo ==========================================================
echo セットアップが完了しました！
echo ・テスト実行: run.bat --dry-run
echo ・本番実行:   run.bat
echo ・メール検索: run.bat --search "キーワード"
echo ==========================================================
pause
